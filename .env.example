# Clave de la API de Anthropic. Se configura como variable de entorno en Vercel,
# NUNCA se escribe en el codigo ni se sube al repositorio.
ANTHROPIC_API_KEY=

# Modelo a utilizar. Se deja configurable para poder cambiarlo sin tocar codigo.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Opcional: si se define, la aplicacion pide este codigo antes de permitir
# conversar. Sirve para que una URL publica no consuma credito de forma abierta.
ACCESS_CODE=

# Opcional: numero maximo de mensajes por hora y por visitante. Por defecto 40.
RATE_LIMIT_PER_HOUR=40
